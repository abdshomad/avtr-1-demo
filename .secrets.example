# Copy to `.secrets` in this directory and fill in real values.
# `.secrets` is gitignored — do not commit it.
#
# Sourced by `./run-3040.sh` (with optional `.env`) and exported into the
# pixi process. Nothing is written into the avtr-1 submodule.
#
# Non-secret config (ports, paths) belongs in `.env` instead — see README.md.


# --- HuggingFace (required for install / artifact download) ------------------

# Read/write token from https://huggingface.co/settings/tokens
# Accept gated access at https://huggingface.co/avaturn-live/avtr-1 before downloading.
# Used non-interactively by ./install.sh (hf auth login + artifact download).
HF_TOKEN=

# Alias also supported by install.sh:
# HUGGING_FACE_HUB_TOKEN=


# --- Conversation engine -----------------------------------------------------

# OpenAI Realtime API key. Required for the `openai` engine in the browser UI.
# The streamer mints short-lived client secrets from this; it is never sent to the browser.
OPENAI__API_KEY=

# Cartesia (optional alternative to OpenAI). Required for the `cartesia` engine.
# CARTESIA_API_KEY=
# CARTESIA_AGENT_ID=


# --- WebRTC ICE / TURN (optional) --------------------------------------------
#
# Leave unset on a laptop or LAN. Set when the streamer runs on a host where
# direct UDP cannot traverse to the browser (typical: cloud VM with blocked
# inbound UDP). See avtr-1/README.md § "TURN server setup".

# Cloudflare Realtime TURN — short-lived per-session credentials are minted
# server-side; the long-lived API token never leaves this machine.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_KEY_TOKEN=

# Alternative: a standard TURN server (self-hosted coturn, etc.). When set,
# takes precedence over Cloudflare.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# STUN server override. Defaults to Google's public STUN.
# STUN_URL=stun:stun.l.google.com:19302
